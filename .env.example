# AI Trip Planner - Environment Variables
# Copy this file to .env and fill in your values

# Maia Router (AI Provider)
MAIA_ROUTER_API_KEY=your_api_key_here
MAIA_ROUTER_MODEL=your_model_here
MAIA_ROUTER_BASE_URL=https://api.maiarouter.com/v1

# App Configuration
VITE_APP_NAME=AI Trip Planner
VITE_DEFAULT_CURRENCY=IDR
VITE_DEFAULT_LOCALE=id-ID

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
